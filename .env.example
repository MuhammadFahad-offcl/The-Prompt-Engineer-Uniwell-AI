# Copy to .env (repo root) and fill in. Never commit .env.

# Which live AI provider to use: gemini (default) or groq
AI_PROVIDER=gemini

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank to use the backend default (gemini-2.5-flash); set to any model your key can access
GEMINI_MODEL=

# Groq (optional alternative) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Leave blank to use the backend default (openai/gpt-oss-120b)
GROQ_MODEL=

# SQLite database location (relative to the backend/ folder when you start uvicorn there)
DATABASE_URL=sqlite:///./uniwell.db

# Allowed CORS origin for the React dev server
FRONTEND_ORIGIN=http://localhost:5173

# development enables /api/demo/seed; set to production to disable it
APP_ENV=development
